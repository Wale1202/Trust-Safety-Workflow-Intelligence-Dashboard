# Copy this file to ".env" and fill in values to enable the OPTIONAL LLM path.
# The app works fully WITHOUT any of these (local rule-based fallback).

# OpenAI-compatible API key. Leave blank / unset to stay in local mode.
OPENAI_API_KEY=

# Optional model override (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
